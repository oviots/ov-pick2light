<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
  <Application>
    <!-- Preserve full dynamic reflection metadata for all Spectre.Console command
         and settings types. NativeAOT strips this by default; Spectre.Console
         needs GetGenericArguments() / BaseType traversal at runtime to discover
         the TSettings type parameter. Nested types use '+' in rd.xml. -->
    <Assembly Name="p2l">
      <Type Name="P2L.CLI.Commands.RootCommand"                Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.RootCommand+Settings"       Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.LightOnCommand"             Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.LightOnCommand+Settings"    Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.LightOffCommand"            Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.LightOffCommand+Settings"   Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.TerminateAllCommand"        Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.TerminateAllCommand+Settings" Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.BatchPickCommand"              Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.BatchPickCommand+Settings"   Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ListDevicesCommand"             Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ListDevicesCommand+Settings"  Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ConfigureDeviceCommand"          Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ConfigureDeviceCommand+Settings" Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ExportCommand"                  Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ExportCommand+Settings"         Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ImportCommand"                  Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ImportCommand+Settings"         Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.RunPickCommand"                 Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.RunPickCommand+Settings"        Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ServeCommand"                   Dynamic="Required All"/>
      <Type Name="P2L.CLI.Commands.ServeCommand+Settings"          Dynamic="Required All"/>
    </Assembly>
    <Assembly Name="P2L.Mqtt">
      <Type Name="P2L.Mqtt.OfflineBufferService"              Dynamic="Required All" />
      <Type Name="P2L.Mqtt.MqttBridgeService"                 Dynamic="Required All" />
      <Type Name="P2L.Mqtt.Configuration.MqttSettings"        Dynamic="Required All" />
      <Type Name="P2L.Mqtt.Configuration.MqttTlsSettings"     Dynamic="Required All" />
    </Assembly>
    <!-- Preserve all Spectre.Console rendering types and their interface vtables.
         Generic dispatch (e.g. IOverflowable, IRenderable, IBordereable) is trimmed
         by the AOT linker unless the entire assembly is kept. -->
    <Assembly Name="Spectre.Console" Dynamic="Required All"/>
    <Assembly Name="Spectre.Console.Cli" Dynamic="Required All"/>
  </Application>
</Directives>
