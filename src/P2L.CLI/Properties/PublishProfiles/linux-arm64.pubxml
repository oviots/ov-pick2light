<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: linux-arm64 (Native AOT)
  Produces a self-contained, single-file binary for 64-bit ARM Linux (Raspberry Pi 4/5, industrial SBCs).
  Cross-compilation from x64 Linux requires the arm64 cross-compile toolchain:
    sudo apt-get install clang llvm binutils-aarch64-linux-gnu
  Usage: dotnet publish src/P2L.CLI/P2L.CLI.csproj /p:PublishProfile=linux-arm64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../../artifacts/linux-arm64/</PublishDir>
  </PropertyGroup>
</Project>
