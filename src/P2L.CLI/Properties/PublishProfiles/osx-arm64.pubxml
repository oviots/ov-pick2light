<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: osx-arm64 (Native AOT)
  Produces a self-contained, single-file binary for Apple Silicon (M1/M2/M3).
  Must be compiled on macOS with Xcode command-line tools installed.
  Usage: dotnet publish src/P2L.CLI/P2L.CLI.csproj /p:PublishProfile=osx-arm64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../../artifacts/osx-arm64/</PublishDir>
  </PropertyGroup>
</Project>
