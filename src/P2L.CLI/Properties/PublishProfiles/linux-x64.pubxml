<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: linux-x64 (Native AOT)
  Produces a self-contained, single-file binary for 64-bit Linux (x86_64).
  Usage: dotnet publish src/P2L.CLI/P2L.CLI.csproj /p:PublishProfile=linux-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../../artifacts/linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
