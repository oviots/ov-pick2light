<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: win-x64 (Native AOT)
  Produces a self-contained, single-file .exe for 64-bit Windows.
  Cross-compilation from non-Windows requires the MSVC toolchain inside WSL2 or a Windows CI runner.
  The WINDOWS_SERVICE define is injected automatically for this RID (see P2L.CLI.csproj).
  Usage: dotnet publish src/P2L.CLI/P2L.CLI.csproj /p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../../artifacts/win-x64/</PublishDir>
  </PropertyGroup>
</Project>
