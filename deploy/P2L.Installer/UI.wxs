<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!-- WixUI customization -->
  <Fragment>
    <UI Id="InstallUI">
      <!-- Welcome dialog -->
      <DialogRef Id="WelcomeDlg" />
      <!-- License agreement -->
      <DialogRef Id="LicenseAgreementDlg" />
      <!-- Installation folder selection -->
      <DialogRef Id="InstallScopeDlg" />
      <!-- Feature selection -->
      <DialogRef Id="FeaturesDlg" />
      <!-- Ready to install -->
      <DialogRef Id="VerifyReadyDlg" />
      <!-- Installation progress -->
      <DialogRef Id="ProgressDlg" />
      <!-- Completion -->
      <DialogRef Id="ResumeDlg" />
      <!-- Installation error -->
      <DialogRef Id="ErrorDlg" />
      <!-- Maintenance/repair/uninstall -->
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <!-- Maintenance options -->
      <DialogRef Id="MaintenanceTypeDlg" />

      <!-- Sequence of dialogs -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="WelcomeDlg" Control="Cancel" Event="SpawnDialog" Value="CancelDlg">1</Publish>

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallScopeDlg">LicenseAccepted = "1"</Publish>

      <Publish Dialog="InstallScopeDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="NewDialog" Value="FeaturesDlg">1</Publish>

      <Publish Dialog="FeaturesDlg" Control="Back" Event="NewDialog" Value="InstallScopeDlg">1</Publish>
      <Publish Dialog="FeaturesDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="FeaturesDlg">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Install" Event="EndDialog" Value="Return">1</Publish>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Cancel" Event="SpawnDialog" Value="CancelDlg">1</Publish>

      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Repair" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Remove" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>

      <Publish Dialog="CancelDlg" Control="OK" Event="EndDialog" Value="Exit">1</Publish>
      <Publish Dialog="ErrorDlg" Control="OK" Event="EndDialog" Value="Exit">1</Publish>
    </UI>

    <!-- Custom properties -->
    <Property Id="WIXUI_INSTALLSCOPE" Value="perMachine" />
    <Property Id="WIXUI_UIMODE" Value="Full" />
  </Fragment>

  <!-- Launch conditions -->
  <Fragment>
    <LaunchCondition Message="This installer requires Windows XP or later.">Installed OR VersionNT >= 501</LaunchCondition>
    <LaunchCondition Message="Administrator privileges are required to install this application.">Privileged</LaunchCondition>
  </Fragment>

  <!-- Installation events -->
  <Fragment>
    <Property Id="INSTALLSERVICE" Value="0" />
    <Property Id="ARPNOTIFYWND" Value="1" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
  </Fragment>
</Wix>
