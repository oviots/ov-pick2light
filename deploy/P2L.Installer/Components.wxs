<?xml version="1.0" encoding="utf-8"?>
<!--
  Components.wxs — File, config, shortcut, and registry components.
  BinaryPath variable must be set to the artifacts\win-<platform> folder.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- ── Binaries + Service registration ──────────────────────────────── -->
  <!--
    ServiceInstall MUST be in the same Component as the service executable File.
    WiX derives the service ImagePath from the Component's File KeyPath.
    Components with only a RegistryValue KeyPath produce a NULL ImagePath →
    service registered but invisible in services.msc and unable to start.
  -->
  <Fragment>
    <ComponentGroup Id="BinaryFiles" Directory="INSTALLFOLDER">

      <!-- p2l.exe — .NET AOT bridge + P2L Windows service -->
      <Component Id="P2LExeComp" Guid="A1B2C3D4-0001-0001-0001-000000000001">
        <File Id="P2LExe"
              Source="$(var.BinaryPath)\p2l.exe"
              KeyPath="yes" />

        <Environment Id="P2LPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />

        <ServiceInstall Id="P2LServiceInstall"
                        Name="P2L"
                        DisplayName="Pick2Light Warehouse Daemon"
                        Description="Pick2Light bridge service — controls Aioi light modules via MQTT."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="serve" />

        <!--
          util:ServiceConfig omitted — WiX 5.0.2 bug: Wix4ExecServiceConfig runs
          before InstallServices in the deferred queue → service not found (0x80070424).
          Configure failure-restart manually after install:
            sc failure P2L reset= 86400 actions= restart/5000/restart/5000/restart/5000
        -->

        <ServiceControl Id="P2LServiceControl"
                        Name="P2L"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- p2l-client.exe — Web dashboard + P2LClient Windows service -->
      <Component Id="P2LClientExeComp" Guid="A1B2C3D4-0002-0002-0002-000000000002">
        <File Id="P2LClientExe"
              Source="$(var.BinaryPath)\p2l-client.exe"
              KeyPath="yes" />

        <ServiceInstall Id="P2LClientServiceInstall"
                        Name="P2LClient"
                        DisplayName="Pick2Light Web Dashboard"
                        Description="Pick2Light web dashboard — accessible at http://localhost:8765"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem" />

        <!-- sc failure P2LClient reset= 86400 actions= restart/5000/restart/5000/restart/5000 -->

        <RegistryKey Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\P2LClient">
          <RegistryValue Name="Environment"
                         Type="multiString"
                         Value="P2L_CLIENT_HOST=127.0.0.1[~]P2L_CLIENT_PORT=8765" />
        </RegistryKey>

        <ServiceControl Id="P2LClientServiceControl"
                        Name="P2LClient"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- e_sqlite3.dll — SQLite native library required by p2l.exe -->
      <Component Id="SqliteDllComp" Guid="A1B2C3D4-0003-0003-0003-000000000003">
        <File Id="SqliteDll"
              Source="$(var.BinaryPath)\e_sqlite3.dll"
              KeyPath="yes" />
      </Component>

      <!-- config\p2l_config.json — P2L bridge default config (NeverOverwrite = user edits survive upgrade) -->
      <Component Id="P2LConfigJsonComp" Guid="A1B2C3D4-0007-0007-0007-000000000007"
                 Directory="SVCCONFIGFOLDER"
                 NeverOverwrite="yes">
        <File Id="P2LConfigJson"
              Source="$(var.BinaryPath)\config\p2l_config.json"
              KeyPath="yes" />
      </Component>

      <!-- config\p2l_client_config.json — Web dashboard default config (NeverOverwrite) -->
      <Component Id="P2LClientConfigJsonComp" Guid="A1B2C3D4-0008-0008-0008-000000000008"
                 Directory="SVCCONFIGFOLDER"
                 NeverOverwrite="yes">
        <File Id="P2LClientConfigJson"
              Source="$(var.ConfigPath)\p2l_client_config.json"
              KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── Configuration: logs directory ───────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="ConfigFiles" Directory="APPDATAFOLDER">

      <!-- logs\ directory placeholder (so the folder is created + removed on uninstall) -->
      <Component Id="LogsFolderComp" Guid="A1B2C3D4-0005-0005-0005-000000000005"
                 Directory="LOGSFOLDER">
        <CreateFolder Directory="LOGSFOLDER">
          <!-- LocalSystem (both services) has full access; Administrators granted explicitly. -->
          <util:PermissionEx
              User="Administrators"
              GenericAll="yes" />
        </CreateFolder>
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── Start Menu shortcuts ──────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="ShortcutComponents" Directory="P2LMENUFOLDER">

      <!-- "Open Dashboard" → browser shortcut to localhost:8765 -->
      <Component Id="DashboardShortcutComp" Guid="A1B2C3D4-0006-0006-0006-000000000006">
        <Shortcut Id="DashboardShortcut"
                  Name="P2L Dashboard"
                  Description="Open Pick2Light web dashboard in browser"
                  Target="[SystemFolder]cmd.exe"
                  Arguments='/c start "" "http://localhost:8765"'
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall P2L"
                  Description="Remove Pick2Light"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="CleanMenuFolder" Directory="P2LMENUFOLDER" On="uninstall" />
        <!-- Registry key required to make this component's shortcuts install correctly -->
        <RegistryValue Root="HKCU"
                       Key="Software\P2L\Shortcuts"
                       Name="installed"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── Registry entries ───────────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="RegistryEntries" Directory="INSTALLFOLDER">

      <Component Id="RegistryComp" Guid="A1B2C3D4-0009-0009-0009-000000000009">
        <!-- Record install path for other tools to discover -->
        <RegistryKey Root="HKLM" Key="Software\P2L">
          <RegistryValue Name="InstallPath"   Value="[INSTALLFOLDER]"   Type="string" />
          <RegistryValue Name="DataPath"      Value="[APPDATAFOLDER]"   Type="string" />
          <RegistryValue Name="Version"       Value="$(var.ProductVersion)" Type="string" />
          <RegistryValue Name="DashboardPort" Value="8765"              Type="string" KeyPath="yes" />
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
