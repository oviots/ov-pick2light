<?xml version="1.0" encoding="utf-8"?>
<!--
  Components.wxs — File, config, shortcut, and registry components.
  BinaryPath variable must be set to the artifacts\win-<platform> folder.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- ── Binaries: p2l.exe, p2l-client.exe, e_sqlite3.dll ─────────────── -->
  <Fragment>
    <ComponentGroup Id="BinaryFiles" Directory="INSTALLFOLDER">

      <!-- p2l.exe — .NET AOT bridge -->
      <Component Id="P2LExeComp" Guid="A1B2C3D4-0001-0001-0001-000000000001">
        <File Id="P2LExe"
              Source="$(var.BinaryPath)\p2l.exe"
              KeyPath="yes" />
        <!-- Add install dir to PATH -->
        <Environment Id="P2LPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>

      <!-- p2l-client dir is fully harvested by P2LClientDirFiles below -->

      <!-- e_sqlite3.dll — SQLite native library required by p2l.exe -->
      <Component Id="SqliteDllComp" Guid="A1B2C3D4-0003-0003-0003-000000000003">
        <File Id="SqliteDll"
              Source="$(var.BinaryPath)\e_sqlite3.dll"
              KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── Configuration: appsettings.json + logs directory ─────────────── -->
  <Fragment>
    <ComponentGroup Id="ConfigFiles" Directory="APPDATAFOLDER">

      <!-- appsettings.json — only install if not already present -->
      <Component Id="AppSettingsComp" Guid="A1B2C3D4-0004-0004-0004-000000000004"
                 NeverOverwrite="yes">
        <File Id="AppSettingsJson"
              Source="$(var.ConfigPath)\appsettings.json"
              KeyPath="yes" />
        <!--
          NeverOverwrite="yes" on Component — upgrade does not clobber user's edited config.
        -->
      </Component>

      <!-- logs\ directory placeholder (so the folder is created + removed on uninstall) -->
      <Component Id="LogsFolderComp" Guid="A1B2C3D4-0005-0005-0005-000000000005"
                 Directory="LOGSFOLDER">
        <CreateFolder Directory="LOGSFOLDER">
          <!-- Grant LocalService write access to logs -->
          <util:PermissionEx
              User="NT SERVICE\P2L"
              GenericAll="yes"
              ChangePermission="no" />
        </CreateFolder>
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── Start Menu shortcuts ──────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="ShortcutComponents" Directory="P2LMENUFOLDER">

      <!-- "Open Dashboard" → browser shortcut to localhost:8765 -->
      <Component Id="DashboardShortcutComp" Guid="A1B2C3D4-0006-0006-0006-000000000006">
        <Shortcut Id="DashboardShortcut"
                  Name="P2L Dashboard"
                  Description="Open Pick2Light web dashboard in browser"
                  Target="[SystemFolder]cmd.exe"
                  Arguments='/c start "" "http://localhost:8765"'
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall P2L"
                  Description="Remove Pick2Light"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="CleanMenuFolder" Directory="P2LMENUFOLDER" On="uninstall" />
        <!-- Registry key required to make this component's shortcuts install correctly -->
        <RegistryValue Root="HKCU"
                       Key="Software\P2L\Shortcuts"
                       Name="installed"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── Registry entries ───────────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="RegistryEntries" Directory="INSTALLFOLDER">

      <Component Id="RegistryComp" Guid="A1B2C3D4-0007-0007-0007-000000000007">
        <!-- Record install path for other tools to discover -->
        <RegistryKey Root="HKLM" Key="Software\P2L">
          <RegistryValue Name="InstallPath"   Value="[INSTALLFOLDER]"   Type="string" />
          <RegistryValue Name="DataPath"      Value="[APPDATAFOLDER]"   Type="string" />
          <RegistryValue Name="Version"       Value="$(var.ProductVersion)" Type="string" />
          <RegistryValue Name="DashboardPort" Value="8765"              Type="string" KeyPath="yes" />
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── P2L Client service registration ──────────────────────────────── -->
  <!--
    ServiceInstall/@ImagePath (WiX 4+ feature) sets the service executable
    path explicitly. This lets us harvest p2l-client/ with <Files> without
    needing to manually define the exe component.
  -->
  <Fragment>
    <ComponentGroup Id="ClientService" Directory="INSTALLFOLDER">
      <Component Id="ClientServiceComp" Guid="B1C2D3E4-0002-0002-0002-000000000002">
        <RegistryValue Root="HKLM"
                       Key="Software\P2L\Services"
                       Name="ClientInstalled"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />

        <ServiceInstall Id="P2LClientServiceInstall"
                        Name="P2LClient"
                        DisplayName="Pick2Light Web Dashboard"
                        Description="Pick2Light web dashboard — accessible at http://localhost:8765"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT SERVICE\P2LClient"
                        ImagePath="&quot;[P2LCLIENTFOLDER]p2l-client.exe&quot;" />

        <util:ServiceConfig
            ServiceName="P2LClient"
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="5"
            ResetPeriodInDays="1" />

        <RegistryKey Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\P2LClient">
          <RegistryValue Name="Environment"
                         Type="multiString"
                         Value="P2L_CLIENT_HOST=0.0.0.0[~]P2L_CLIENT_PORT=8765" />
        </RegistryKey>

        <ServiceControl Id="P2LClientServiceControl"
                        Name="P2LClient"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ── P2L Client onedir: all files harvested from p2l-client\ ──────── -->
  <Fragment>
    <ComponentGroup Id="P2LClientDirFiles" Directory="P2LCLIENTFOLDER">
      <!--
        WiX 5 <Files Path="glob"> auto-harvests all files and subdirectories
        from the PyInstaller onedir output (p2l-client.exe + _internal\).
        Path uses ** to recurse into subdirectories.
      -->
      <Files Path="$(var.BinaryPath)\p2l-client\**" />
    </ComponentGroup>
  </Fragment>

</Wix>
