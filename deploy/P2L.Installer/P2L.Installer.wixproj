<?xml version="1.0" encoding="utf-8"?>
<!-- P2L.Installer.wixproj: WiX 5 SDK MSI project. Build via deploy/build-msi.ps1 or build-msi.sh -->
<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <ProductVersion>1.0.0</ProductVersion>
    <OutputName>P2L-$(ProductVersion)-$(Platform)</OutputName>

    <!-- Paths resolved relative to repo root (two levels up from this file) -->
    <RepoRoot>$(MSBuildProjectDirectory)\..\..</RepoRoot>
    <BinaryPath Condition="'$(Platform)' == 'x64'"  >$(RepoRoot)\artifacts\win-x64</BinaryPath>
    <BinaryPath Condition="'$(Platform)' == 'arm64'">$(RepoRoot)\artifacts\win-arm64</BinaryPath>
    <ConfigPath>$(MSBuildProjectDirectory)\Assets</ConfigPath>
    <LicenseRtf>$(MSBuildProjectDirectory)\Assets\License.rtf</LicenseRtf>
  </PropertyGroup>

  <ItemGroup>
    <!-- WiX extensions -->
    <PackageReference Include="WixToolset.UI.wixext"   Version="5.*" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.*" />
  </ItemGroup>

  <!-- WiX 5 SDK auto-discovers all *.wxs files — no explicit <Compile> needed -->

  <!-- Preprocessor variables passed to every WXS file as $(var.Name) -->
  <ItemGroup>
    <BindPath Include="$(BinaryPath)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Passed as -d flags to wix.exe -->
    <DefineConstants>
      ProductVersion=$(ProductVersion);
      BinaryPath=$(BinaryPath);
      ConfigPath=$(ConfigPath);
      LicenseRtf=$(LicenseRtf)
    </DefineConstants>
  </PropertyGroup>

  <!-- Validate required binaries exist before attempting a build -->
  <Target Name="ValidateBinaries" BeforeTargets="Build">
    <Error Text="p2l.exe not found: $(BinaryPath)\p2l.exe — run 'dotnet publish' for win-$(Platform) first."
           Condition="!Exists('$(BinaryPath)\p2l.exe')" />
    <Error Text="p2l-client.exe not found: $(BinaryPath)\p2l-client.exe — run deploy\build-client.sh first."
           Condition="!Exists('$(BinaryPath)\p2l-client.exe')" />
    <Error Text="e_sqlite3.dll not found: $(BinaryPath)\e_sqlite3.dll — required for SQLite support."
           Condition="!Exists('$(BinaryPath)\e_sqlite3.dll')" />
    <Error Text="config\p2l_config.json not found: $(BinaryPath)\config\p2l_config.json — run 'dotnet publish' first."
           Condition="!Exists('$(BinaryPath)\config\p2l_config.json')" />
    <Error Text="License.rtf not found: $(LicenseRtf) — create Assets\License.rtf."
           Condition="!Exists('$(LicenseRtf)')" />
  </Target>

</Project>
