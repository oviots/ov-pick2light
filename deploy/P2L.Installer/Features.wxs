<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!-- Main binary component -->
  <Fragment>
    <ComponentGroup Id="BinaryFiles" Directory="BinFolder">
      <Component Id="P2LBinary" Guid="12345678-1234-1234-1234-111111111111">
        <File Id="P2LExe" 
              Source="!(bind.fileDirectory.BinFolder)\p2l.exe"
              KeyPath="yes"
              Checksum="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Environment PATH modification -->
  <Fragment>
    <ComponentGroup Id="PathEnvironment" Directory="INSTALLFOLDER">
      <Component Id="PathEnvironment" Guid="12345678-1234-1234-1234-222222222222">
        <RegistryValue Root="HKLM"
                       Key="Software\Pick2Light\P2L"
                       Name="InstallPath"
                       Value="[INSTALLFOLDER]bin\"
                       Type="string"
                       KeyPath="yes" />
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]bin\" Permanent="no" Part="first" Action="set" System="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Uninstall registry entry -->
  <Fragment>
    <ComponentGroup Id="UninstallRegistry" Directory="INSTALLFOLDER">
      <Component Id="UninstallRegistry" Guid="12345678-1234-1234-1234-333333333333">
        <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{87654321-4321-4321-4321-210987654321}">
          <RegistryValue Name="DisplayName" Value="Pick2Light (P2L) Warehouse Control System" Type="string" />
          <RegistryValue Name="DisplayVersion" Value="1.0.0" Type="string" />
          <RegistryValue Name="InstallLocation" Value="[INSTALLFOLDER]" Type="string" />
          <RegistryValue Name="Publisher" Value="Pick2Light" Type="string" />
          <RegistryValue Name="UninstallString" Value="msiexec.exe /x {87654321-4321-4321-4321-210987654321}" Type="string" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Start Menu shortcuts -->
  <Fragment>
    <ComponentGroup Id="StartMenuShortcuts" Directory="ProgramMenuDir">
      <Component Id="P2LShortcut" Guid="12345678-1234-1234-1234-444444444444">
        <Shortcut Id="P2LStartMenuShortcut"
                  Name="P2L Command Prompt"
                  Description="Pick2Light Warehouse Control System"
                  Target="cmd.exe"
                  Arguments="/K p2l --help"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Pick2Light\P2L" Name="installed" Value="1" Type="integer" KeyPath="yes" />
      </Component>
      <Component Id="DocumentationShortcut" Guid="12345678-1234-1234-1234-555555555555">
        <Shortcut Id="DocumentationShortcut"
                  Name="Documentation"
                  Description="Open P2L documentation"
                  Target="https://github.com/pick2light/p2l#readme"
                  Directory="ProgramMenuDir" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Service registration (optional - user choice during install) -->
  <Fragment>
    <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
      <Component Id="P2LServiceRegistration" Guid="12345678-1234-1234-1234-666666666666">
        <Condition>INSTALLSERVICE=1</Condition>
        <ServiceInstall Id="P2LService"
                        Name="P2LWarehouseService"
                        DisplayName="Pick2Light Warehouse Control Service"
                        Description="Native AOT warehouse control system for Aioi light modules"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Arguments=""
                        KeyPath="yes" />
        <ServiceControl Id="P2LServiceControl"
                        Name="P2LWarehouseService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
