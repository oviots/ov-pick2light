<?xml version="1.0" encoding="utf-8"?>
<!--
  Product.wxs — Main WiX 4 package definition for Pick2Light (P2L).

  Produces: P2L-<version>-<platform>.msi
  Installs:
    C:\Program Files\P2L\
      p2l.exe               P2L .NET bridge service
      p2l-client.exe        P2L web dashboard (standalone)
      e_sqlite3.dll         SQLite native library
    C:\ProgramData\P2L\
      appsettings.json      Bridge configuration
      logs\                 Log directory

  Services registered:
    P2L            — Pick2Light Warehouse Daemon  (auto-start)
    P2LClient      — Pick2Light Web Dashboard     (auto-start)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Pick2Light (P2L) Warehouse Control System"
           Manufacturer="Pick2Light"
           Version="$(var.ProductVersion)"
           UpgradeCode="87654321-4321-4321-4321-210987654321"
           Language="1033"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perMachine">

    <!-- Upgrade: remove older versions, block downgrade -->
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of Pick2Light is already installed. Uninstall it first." />

    <!-- Single embedded CAB -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ── Install directories ─────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="P2L">
        <!-- Onedir PyInstaller output — avoids %TEMP% extraction/AV blocking -->
        <Directory Id="P2LCLIENTFOLDER" Name="p2l-client" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="APPDATAFOLDER" Name="P2L">
        <Directory Id="LOGSFOLDER" Name="logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="P2LMENUFOLDER" Name="Pick2Light" />
    </StandardDirectory>

    <!-- ── Features ───────────────────────────────────────────────────── -->
    <Feature Id="ProductFeature"
             Title="Pick2Light Core"
             Description="P2L bridge service, web dashboard, and SQLite runtime."
             Level="1"
             AllowAdvertise="no"
             Display="expand">

      <ComponentGroupRef Id="BinaryFiles" />
      <ComponentGroupRef Id="P2LClientDirFiles" />
      <ComponentGroupRef Id="BridgeService" />
      <ComponentGroupRef Id="ConfigFiles" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="RegistryEntries" />
    </Feature>

    <!-- ── UI (WiX standard InstallDir dialog) ───────────────────────── -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Skip license dialog (set to your own RTF if you have one) -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Banner and dialog bitmaps (optional, comment out if not provided) -->
    <!-- <WixVariable Id="WixUIBannerBmp"  Value="Assets\banner.bmp"  /> -->
    <!-- <WixVariable Id="WixUIDialogBmp"  Value="Assets\dialog.bmp"  /> -->

  </Package>
</Wix>
