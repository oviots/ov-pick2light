<?xml version="1.0" encoding="utf-8"?>
<!--
  Services.wxs — Windows Service installation for p2l.exe and p2l-client.exe.

  p2l.exe runs as NT SERVICE\P2L (virtual service account — no password needed).
  p2l-client.exe also runs as NT SERVICE\P2LClient.
  Both services are set to auto-start and restart on failure.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- ── P2L Bridge Service (p2l.exe) ──────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="BridgeService" Directory="INSTALLFOLDER">

      <Component Id="BridgeServiceComp" Guid="B1C2D3E4-0001-0001-0001-000000000001">
        <!-- KeyPath via registry — file is already installed by BinaryFiles -->
        <RegistryValue Root="HKLM"
                       Key="Software\P2L\Services"
                       Name="BridgeInstalled"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />

        <ServiceInstall Id="P2LServiceInstall"
                        Name="P2L"
                        DisplayName="Pick2Light Warehouse Daemon"
                        Description="Pick2Light bridge service — controls Aioi light modules via MQTT."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT SERVICE\P2L"
                        Arguments='run "[APPDATAFOLDER]tasks.csv"' />

        <!-- Failure actions: restart after 5s, reset counter after 1 day -->
        <util:ServiceConfig
            ServiceName="P2L"
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="5"
            ResetPeriodInDays="1" />

        <ServiceControl Id="P2LServiceControl"
                        Name="P2L"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── P2L Client Service (p2l-client.exe) ───────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="ClientService" Directory="INSTALLFOLDER">

      <Component Id="ClientServiceComp" Guid="B1C2D3E4-0002-0002-0002-000000000002">
        <!-- KeyPath via registry — file is already installed by BinaryFiles -->
        <RegistryValue Root="HKLM"
                       Key="Software\P2L\Services"
                       Name="ClientInstalled"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />

        <ServiceInstall Id="P2LClientServiceInstall"
                        Name="P2LClient"
                        DisplayName="Pick2Light Web Dashboard"
                        Description="Pick2Light web dashboard — accessible at http://localhost:8765"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT SERVICE\P2LClient" />

        <util:ServiceConfig
            ServiceName="P2LClient"
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="5"
            ResetPeriodInDays="1" />

        <!-- Set environment variables for the service via registry -->
        <RegistryKey Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\P2LClient">
          <RegistryValue Name="Environment"
                         Type="multiString"
                         Value="P2L_CLIENT_HOST=0.0.0.0[~]P2L_CLIENT_PORT=8765" />
        </RegistryKey>

        <ServiceControl Id="P2LClientServiceControl"
                        Name="P2LClient"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
