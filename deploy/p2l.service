[Unit]
Description=Pick2Light (P2L) Warehouse Control Daemon
Documentation=https://github.com/your-org/p2l
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=p2l
Group=p2l
WorkingDirectory=/opt/p2l

# Run the MQTT bridge continuously; CSV commands are one-shot.
ExecStart=/opt/p2l/p2l serve

# systemd sends SIGTERM on stop → P2L's PosixSignalRegistration drains TCP queue.
KillSignal=SIGTERM
TimeoutStopSec=20s

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=p2l

# Hardening: limit blast radius
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/p2l/logs /opt/p2l

# Optional environment overrides — uncomment and adjust as needed:
# Environment=P2L_GATEWAY__HOST=192.168.1.254
# Environment=P2L_GATEWAY__PORT=5003
# Environment=P2L_MQTT__ENABLED=false

[Install]
WantedBy=multi-user.target
