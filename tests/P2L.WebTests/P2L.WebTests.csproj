<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/P2L.Mqtt/P2L.Mqtt.csproj" />
    <Compile Include="../../src/P2L.CLI/Web/*.cs" Link="Web/%(Filename)%(Extension)" />
    <Compile Include="../../src/P2L.CLI/Configuration/AppSettings.cs" Link="AppSettings.cs" />
    <EmbeddedResource Include="../../client/templates/index.html" LogicalName="P2L.Web/index.html" />
    <EmbeddedResource Include="../../client/static/**/*" LogicalName="P2L.Web/static/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
