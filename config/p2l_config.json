{
  "LogDirectory": "logs",
  "MaxLogFileSizeBytes": 10485760,
  "EnableStatePersistence": false,
  "SelfHeal": {
    "Enabled": true,
    "MaxRestarts": 5,
    "RestartWindowMinutes": 10,
    "BackOffSeconds": 3,
    "WatchdogTimeoutMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "P2L.Hardware": "Debug",
      "P2L.Mqtt": "Debug",
      "Microsoft.Hosting": "Warning"
    }
  }
}
